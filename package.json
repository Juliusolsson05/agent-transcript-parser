{
  "name": "agent-transcript-parser",
  "version": "0.1.0",
  "description": "Evidence-driven transcript classification, analysis, and provider-neutral projection.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ghost": {
      "types": "./dist/ghost.d.ts",
      "default": "./dist/ghost.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:probe": "tsc -p testing/tsconfig.json",
    "test": "vitest run",
    "test:core": "vitest run --project core --passWithNoTests",
    "test:system": "vitest run --project system --passWithNoTests",
    "test:corpus": "vitest run --project corpus",
    "test:live": "vitest run --config vitest.live.config.ts --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "test:contract": "node scripts/check-test-contract.mjs",
    "corpus:extract-observed": "tsx testing/corpus/extract-observed-fixtures.mts",
    "corpus:extract-sequences": "tsx testing/corpus/extract-observed-sequences.mts",
    "corpus:profile": "tsx testing/corpus/profile-local-corpus.mts",
    "probe:live-resume": "tsx testing/live-resume-probe.mts",
    "check": "npm run test:contract && npm run typecheck && npm test && npm run test:package",
    "verify": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "node-pty": "^1.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
